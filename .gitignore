*.log
*.tmp
*.swp
*~
*.bak
*.bak.*
*.orig
*.bak/

# 配置文件（本地运行时配置，含令牌，绝不入库）
config.yaml
backgrounds/

# IDE
.vscode/
.idea/
*.iml

# 系统文件
.DS_Store
Thumbs.db
web-ui/node_modules/
