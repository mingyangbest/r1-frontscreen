#!/bin/bash
# 升级前：停服务并备份配置，升级失败可人工回退。
#
# 注意：cmd 脚本由飞牛放在 /var/apps/<appname>/cmd/，不在 $TRIM_APPDEST 下
# （APPDEST 只对应包里的 app/ 目录）。拼 $TRIM_APPDEST/cmd/main 会 exit 127，
# 旧进程继续占着 DRM，新版本起不来。用脚本自身位置定位。
CMD_DIR="$(cd "$(dirname "$0")" && pwd)"
LOG="${TRIM_PKGVAR:-/tmp}/service.log"

if ! "$CMD_DIR/main" stop >> "$LOG" 2>&1; then
  echo "$(date '+%F %T') [upgrade_init] main stop 返回非 0，服务可能未停止" >> "$LOG"
fi

# main stop 无论成败都返回 0，只看退出码查不出问题 —— 真正的判据是进程没了
if [ -r "${TRIM_PKGVAR}/worker.pid" ]; then
  pid=$(cat "${TRIM_PKGVAR}/worker.pid" 2>/dev/null)
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    echo "$(date '+%F %T') [upgrade_init] 停止后 worker($pid) 仍存活，升级后可能抢 DRM" >> "$LOG"
  fi
fi

if [ -f "${TRIM_PKGETC}/config.yaml" ]; then
  mkdir -p "${TRIM_PKGVAR}/backup"
  cp -a "${TRIM_PKGETC}/config.yaml" \
        "${TRIM_PKGVAR}/backup/config.yaml.$(date +%Y%m%d-%H%M%S)"
  # 只留最近 5 份，反复升级不至于把数据目录塞满
  ls -1t "${TRIM_PKGVAR}/backup"/config.yaml.* 2>/dev/null \
    | tail -n +6 | xargs -r rm -f
fi

exit 0
