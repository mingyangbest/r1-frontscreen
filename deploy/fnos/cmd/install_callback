#!/bin/bash
# 安装后：探测硬件路径、生成配置、停用会抢 DRM 的旧服务。

ETC="${TRIM_PKGETC:?}"
APPDEST="${TRIM_APPDEST:?}"
VAR="${TRIM_PKGVAR:?}"

mkdir -p "$ETC" "$VAR"

# 1) 探测背光节点与 hwmon
brightness=""
for d in /sys/class/backlight/*/; do
  if [ -w "${d}brightness" ]; then
    brightness="/sys/class/backlight/$(basename "$d")/brightness"
    break
  fi
done

hwmon=""
for d in /sys/class/hwmon/hwmon*/; do
  n=$(cat "${d}name" 2>/dev/null)
  case "$n" in
    it87|it8628|it8613)
      hwmon="/sys/class/hwmon/$(basename "$d")"
      break
      ;;
  esac
done

# 2) 生成配置：已存在则保留，绝不覆盖用户调过的值
if [ ! -f "$ETC/config.yaml" ]; then
  legacy=""
  for p in /etc/r1-toolbox/config.yaml /etc/r1-control/config.yaml; do
    if [ -f "$p" ]; then legacy="$p"; break; fi
  done

  if [ -n "$legacy" ]; then
    cp -a "$legacy" "$ETC/config.yaml"
    echo "已迁移命令行版配置：$legacy"
  else
    cp "$APPDEST/config.example.yaml" "$ETC/config.yaml"
  fi
fi

# 3) 用实测值覆盖硬件路径（旧配置里的绝对路径可能属于另一台机器）
if [ -n "$brightness" ]; then
  sed -i "s|^\([[:space:]]*brightness_path:\).*|\1 $brightness|" "$ETC/config.yaml"
fi
if [ -n "$hwmon" ]; then
  sed -i "s|^\([[:space:]]*hwmon_path:\).*|\1 $hwmon|" "$ETC/config.yaml"
fi

chmod 600 "$ETC/config.yaml"

# 4) 把配置里的实际端口写进桌面入口
#
# 飞牛拼桌面入口地址的公式是 {protocol}://{hostname}:{port}{url}，port 是
# 字面量，${port} / {port} 占位符都不会被替换（1.2.0903 实测）。
#
# 但这段代码实测也不生效：飞牛在解压完成后就解析并缓存了入口，执行到
# install_callback 时已经晚了 —— 配置改成 9090 重装，文件层面 ui/config 是
# 9090、应用监听 9090，桌面图标点出来还是包内写死的 8080。
#
# 留着它有两层意义：一是保证 ui/config 与用户配置一致（手动排查时对得上）；
# 二是万一飞牛把解析时序挪到 install_callback 之后，它会自动生效。
#
# 已知限制：入口端口固定为包内 ui/config 写的 8080。用户改 config.yaml 的
# web.port 后，桌面图标失效，面板仍可通过新端口手动访问（见文档 §5.4）。
PORT=$(awk '/^[[:space:]]*port:/{print $2; exit}' "$ETC/config.yaml" 2>/dev/null)
case "$PORT" in
  ''|*[!0-9]*) PORT=8080 ;;
esac

UICFG="$APPDEST/ui/config"
if [ -f "$UICFG" ]; then
  sed -i "s|\"port\": \"[0-9]*\"|\"port\": \"$PORT\"|" "$UICFG"
fi

# 5) 停用旧的 systemd 单元：两个实例会抢同一个 DRM 设备
UNIT=/etc/systemd/system/r1-toolbox.service
if [ -f "$UNIT" ]; then
  mkdir -p "$VAR/legacy"
  cp -a "$UNIT" "$VAR/legacy/" 2>/dev/null
  systemctl disable --now r1-toolbox.service >/dev/null 2>&1
  echo "已停用命令行版 r1-toolbox.service，单元文件备份在 $VAR/legacy/"
fi

# 6) 非 root 运行所需的权限
#
# 应用以 package 用户（r1-frontscreen）运行，但需要 root 才拿得到的资源有四个：
#   /dev/dri/card1            root:video 660  → 加 video 组
#   /var/run/docker.sock      root:docker 660 → 加 docker 组
#   /sys/class/backlight/*    root:root 644   → udev 给 video 组写权限
#   /sys/class/hwmon/*/pwm*   root:root 644   → 同上
# 安装脚本以 root 执行，正好在这里一次性补齐。
APP_USER="r1-frontscreen"
if id "$APP_USER" >/dev/null 2>&1; then
  usermod -aG video,docker "$APP_USER" 2>/dev/null
fi

RULES=/etc/udev/rules.d/99-r1-frontscreen.rules
cat > "$RULES" <<'UDEV'
# R1 前置屏：背光与风扇 PWM 对 video 组开放写权限，应用以非特权用户运行
SUBSYSTEM=="backlight", ACTION=="add", RUN+="/bin/sh -c 'chgrp video /sys/class/backlight/%k/brightness 2>/dev/null; chmod 0660 /sys/class/backlight/%k/brightness 2>/dev/null'"
SUBSYSTEM=="hwmon", ACTION=="add", RUN+="/bin/sh -c 'chgrp video /sys/class/hwmon/%k/pwm* 2>/dev/null; chmod 0660 /sys/class/hwmon/%k/pwm* 2>/dev/null'"
UDEV
udevadm control --reload-rules 2>/dev/null

# 已存在的节点立即生效，不必等重启
for f in /sys/class/backlight/*/brightness; do
  [ -e "$f" ] || continue
  chgrp video "$f" 2>/dev/null
  chmod 0660 "$f" 2>/dev/null
done
for d in /sys/class/hwmon/hwmon*/; do
  case "$(cat "${d}name" 2>/dev/null)" in
    it87|it8628|it8613)
      chgrp video "${d}"pwm* 2>/dev/null
      chmod 0660 "${d}"pwm* 2>/dev/null
      ;;
  esac
done

# 复查：权限没落到位要留痕，功能会静默降级（亮度调不动、风扇不跟温度）
if id "$APP_USER" >/dev/null 2>&1; then
  for f in /sys/class/backlight/*/brightness; do
    [ -e "$f" ] || continue
    if ! sudo -u "$APP_USER" test -w "$f" 2>/dev/null; then
      echo "警告：$f 对 $APP_USER 不可写，亮度调节可能失效" >&2
    fi
    break
  done
fi

exit 0
