#!/bin/bash
# fpk 生命周期入口。start / stop 幂等，status 返回 0（运行中）或 3（未运行）。

set -u

VAR="${TRIM_PKGVAR:?}"
ETC="${TRIM_PKGETC:?}"
APPDEST="${TRIM_APPDEST:?}"

LOG="$VAR/service.log"
SUP_PID="$VAR/supervisor.pid"
STOP_FLAG="$VAR/stop.flag"
HB="$VAR/heartbeat"

alive() {
  [ -f "$1" ] || return 1
  pid=$(cat "$1" 2>/dev/null)
  [ -n "$pid" ] || return 1
  kill -0 "$pid" 2>/dev/null
}

do_start() {
  if alive "$SUP_PID"; then
    return 0
  fi

  APP_USER="${TRIM_USERNAME:-r1-frontscreen}"
  APP_GROUP="${TRIM_GROUPNAME:-$APP_USER}"

  mkdir -p "$VAR/runtime" "$VAR/cache"
  chmod 700 "$VAR/runtime"

  export SDL_VIDEODRIVER=kmsdrm
  export XDG_RUNTIME_DIR="$VAR/runtime"
  # SDL 的 shader cache 默认写 $HOME/.cache，包用户没有可写的家目录，
  # 不指定就会在日志里刷 "Failed to create ... for shader cache"
  export XDG_CACHE_HOME="$VAR/cache"
  export LD_LIBRARY_PATH="$APPDEST/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
  export R1_DATA_DIR="$VAR"
  export R1_FONT_DIR="$APPDEST/share/fonts"
  export R1_HEARTBEAT_FILE="$HB"

  rm -f "$STOP_FLAG"
  date +%s > "$HB"

  # 生命周期脚本是 root（要用 udev、改用户组），长期进程必须降权：
  # 官方建议「在启动用户可访问服务前降权」。日志与运行目录先交给包用户，
  # 否则 runuser 起来的进程写不进去。
  touch "$LOG" 2>/dev/null
  chown "$APP_USER:$APP_GROUP" "$LOG" "$HB" 2>/dev/null
  chown -R "$APP_USER:$APP_GROUP" "$VAR" 2>/dev/null

  # 记下起始行号：下面只看本次启动新增的日志，历史崩溃不干扰判断
  mark=$(wc -l < "$LOG" 2>/dev/null || echo 0)

  # runuser 切身份，环境变量照常传递；supervisor 会把自己的 pid 写进 SUP_PID
  nohup runuser -u "$APP_USER" -- "$APPDEST/bin/supervisor.sh" >> "$LOG" 2>&1 &

  sleep 3

  if ! alive "$SUP_PID"; then
    echo "守护进程未能启动，详见 $LOG" > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
    return 1
  fi

  # 守护壳活着不代表服务起来了：worker 秒退崩溃循环时，它同样活着
  if ! alive "$VAR/worker.pid"; then
    echo "服务进程未能启动，详见 $LOG" > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
    do_stop >/dev/null 2>&1
    return 1
  fi

  newlog=$(tail -n +$((mark + 1)) "$LOG" 2>/dev/null)

  # 缺库的典型特征：动态链接器在 main 之前就把进程干掉了
  if echo "$newlog" | grep -q "error while loading shared libraries"; then
    echo "启动失败，缺少动态库：$(echo "$newlog" | grep 'error while loading shared libraries' | head -1)" \
      > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
    do_stop >/dev/null 2>&1
    return 1
  fi

  # 本次启动内已经出现过 worker 退出，说明起不来
  if echo "$newlog" | grep -q "worker 退出 rc="; then
    echo "服务进程启动后立即退出，详见 $LOG" > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
    do_stop >/dev/null 2>&1
    return 1
  fi

  return 0
}

do_stop() {
  touch "$STOP_FLAG"

  if alive "$SUP_PID"; then
    kill -TERM "$(cat "$SUP_PID")" 2>/dev/null
    for _ in $(seq 1 10); do
      alive "$SUP_PID" || break
      sleep 1
    done
    alive "$SUP_PID" && kill -KILL "$(cat "$SUP_PID")" 2>/dev/null
  fi

  # 守护壳退出时会带走 worker；这里再兜一次，防止孤儿进程占着 DRM
  if alive "$VAR/worker.pid"; then
    kill -TERM "$(cat "$VAR/worker.pid")" 2>/dev/null
    sleep 1
    kill -KILL "$(cat "$VAR/worker.pid")" 2>/dev/null
  fi

  rm -f "$SUP_PID" "$VAR/worker.pid"
  return 0
}

case "${1:-}" in
  start)  do_start  ;;
  stop)   do_stop   ;;
  status)
    if alive "$SUP_PID"; then exit 0; else exit 3; fi
    ;;
  *) exit 1 ;;
esac
