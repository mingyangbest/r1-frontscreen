os_min_version        = 1.2.0

service_port          = 8080
checkport             = false
ctl_stop              = true

desktop_uidir         = ui
desktop_applaunchname = r1-frontscreen.Application

changelog             = 1.0.1：修复面板鉴权可被伪造 X-Forwarded-For 绕过、补服务端读写超时与 1MB 请求体上限、磁盘扫描同一时间只允许一次；温度源失联改为沿用上次有效读数，超过 15 秒才升档并在屏幕上提示，恢复后自动消失。
